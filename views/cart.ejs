<div class="container cart-page py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <p class="text-primary fw-semibold mb-1">SHOPPING CART</p>
            <h1 class="mb-1">Your Cart</h1>
            <p class="text-muted mb-0">Review your items and quantities before checkout.</p>
        </div>
        <a href="/inventory" class="btn btn-outline-primary">Continue Shopping</a>
    </div>

    <% if (message) { %>
        <div class="site-alert site-alert-info mb-4" role="status">
            <div class="site-alert-icon">✓</div>
            <div><%= message %></div>
        </div>
    <% } %>

    <% if (warning) { %>
        <div class="site-alert site-alert-warning mb-4" role="alert">
            <div class="site-alert-icon">!</div>
            <div><%= warning %></div>
        </div>
    <% } %>

    <% if (!items || items.length === 0) { %>
        <div class="card border-0 shadow-sm empty-cart-card">
            <div class="card-body text-center p-5">
                <div class="empty-cart-icon mb-3">🛒</div>
                <h2 class="h4">Your cart is empty</h2>
                <p class="text-muted mb-4">Browse the shop and add a few aquarium favourites.</p>
                <a href="/inventory" class="btn btn-primary">Browse Products</a>
            </div>
        </div>
    <% } else { %>
        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                <div class="cart-items">
                    <% items.forEach(item => { %>
                        <div class="card border-0 shadow-sm cart-item mb-3">
                            <div class="card-body p-3 p-md-4">
                                <div class="row g-3 align-items-center">
                                    <div class="col-4 col-md-2">
                                        <img src="<%= item.product.imageUrl %>" alt="<%= item.product.title %>" class="cart-product-image">
                                    </div>
                                    <div class="col-8 col-md-4">
                                        <div class="small text-primary fw-semibold text-uppercase"><%= item.product.category %></div>
                                        <h2 class="h5 mb-1"><%= item.product.title %></h2><% if(item.variant) { %><div class="small text-muted">Variation: <%= item.variant.label %> · <%= item.variant.sku %></div><% } %>
                                        <div class="text-muted">$<%= item.unitPrice.toFixed(2) %> each</div>
                                        <div class="small mt-1 <%= item.availableStock <= 3 ? 'text-danger fw-semibold' : 'text-muted' %>">
                                            <%= item.availableStock %> available
                                        </div>
                                    </div>
                                    <div class="col-7 col-md-3">
                                        <form method="POST" action="/cart/update/<%= item.product._id %>" class="quantity-form"><input type="hidden" name="variantId" value="<%= item.variant ? item.variant._id : '' %>">
                                            <label class="form-label small mb-1" for="qty-<%= item.product._id %>">Quantity</label>
                                            <div class="input-group">
                                                <input id="qty-<%= item.product._id %>" type="number" class="form-control" name="quantity" min="1" max="<%= item.availableStock %>" value="<%= item.quantity %>" aria-label="Quantity for <%= item.product.title %>">
                                                <button class="btn btn-outline-primary" type="submit">Update</button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="col-5 col-md-3 text-end">
                                        <div class="fw-bold fs-5 mb-2">$<%= item.lineTotal.toFixed(2) %></div>
                                        <form method="POST" action="/cart/remove/<%= item.product._id %>"><input type="hidden" name="variantId" value="<%= item.variant ? item.variant._id : '' %>">
                                            <button type="submit" class="btn btn-sm btn-link cart-remove-btn p-0 text-decoration-none">Remove</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm order-summary">
                    <div class="card-body p-4">
                        <h2 class="h4 mb-4">Order Summary</h2>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Items</span>
                            <span><%= totalQuantity %></span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Subtotal</span>
                            <span>$<%= subtotal.toFixed(2) %></span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Shipping</span>
                            <span class="text-muted">Calculated at checkout</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <strong>Current total</strong>
                            <strong class="fs-4 text-primary">$<%= subtotal.toFixed(2) %></strong>
                        </div>
                        <form method="POST" action="/checkout">
                            <button class="btn btn-primary w-100" type="submit">Place Order</button>
                        </form>
                        <p class="small text-muted text-center mt-2 mb-0">Stock is checked again before the order is placed. This portfolio checkout does not process a real payment.</p>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>
