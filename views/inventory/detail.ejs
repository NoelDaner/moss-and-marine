<% const hasVariants = product.variants && product.variants.length > 0; const totalStock = hasVariants ? product.variants.reduce((n,v)=>n+v.stockQuantity,0) : product.stockQuantity; %>
<div class="container py-5">
    <nav class="site-breadcrumb mb-4" aria-label="Breadcrumb">
        <a href="/" class="breadcrumb-pill breadcrumb-home" aria-label="Home">⌂</a>
        <span class="breadcrumb-separator">›</span>
        <a href="/inventory" class="breadcrumb-pill">Shop</a>
        <span class="breadcrumb-separator">›</span>
        <a href="/inventory?category=<%= encodeURIComponent(product.category) %>" class="breadcrumb-pill"><%= product.category %></a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-pill active" aria-current="page"><%= product.title %></span>
    </nav>

    <div class="product-detail-card">
        <div class="row g-0 align-items-stretch">
            <div class="col-lg-5 product-detail-media <%= (product.animalType === 'Shrimp') ? 'product-detail-shrimp' : '' %> <%= (totalStock || 0) <= 0 ? 'product-detail-media-sold-out' : '' %>">
                <% if ((totalStock || 0) <= 0) { %>
                    <span class="product-status-ribbon product-status-sold-out">Sold Out</span>
                <% } else if (product.salePrice && !hasVariants) { %>
                    <span class="product-status-ribbon product-status-sale">Sale</span>
                <% } %>
                <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="product-detail-image <%= (product.animalType === 'Shrimp') ? 'product-detail-photo' : '' %>">
            </div>

            <div class="col-lg-7">
                <div class="product-detail-content">
                    <p class="product-category mb-2"><%= product.category %></p>
                    <h1 class="product-detail-title"><%= product.title %></h1>

                    <div class="product-detail-price mb-4">
                        <% if (product.salePrice && !hasVariants) { %>
                            <span class="text-decoration-line-through text-muted me-2">$<%= (hasVariants ? Math.min(...product.variants.map(v => v.price)) : product.price).toFixed(2) %></span>
                            <span class="sale-price">$<%= product.salePrice.toFixed(2) %></span>
                        <% } else { %>
                            <span>$<%= (hasVariants ? Math.min(...product.variants.map(v => v.price)) : product.price).toFixed(2) %></span>
                        <% } %>
                    </div>

                    <% if (product.description && product.description.trim()) { %>
                    <div class="product-detail-description mb-4">
                        <h2>About this product</h2>
                        <p><%= product.description %></p>
                    </div>
                    <% } %>

                    <dl class="product-detail-meta mb-4">
                        <div>
                            <dt>Availability</dt>
                            <dd>
                                <% if ((totalStock || 0) <= 0) { %>
                                    <span class="fw-semibold">Sold out</span>
                                <% } else { %>
                                    <span class="fw-semibold"><%= totalStock %> in stock</span>
                                    <% if (totalStock <= 3) { %>
                                        <span class="low-stock-text"> · Only <%= totalStock %> left</span>
                                    <% } %>
                                <% } %>
                            </dd>
                        </div>
                        <div>
                            <dt>SKU</dt>
                            <dd><code><%= hasVariants ? 'See selected variation' : (product.sku || 'Legacy product — SKU pending') %></code></dd>
                        </div>
                        <% const specs = product.specifications || {}; %>
                        <% if (['Aquatic Life','Live Fish'].includes(product.category)) { %>
                            <% if (specs.lifespan) { %><div><dt>Lifespan</dt><dd><%= specs.lifespan %></dd></div><% } %>
                            <% if (specs.minimumTankSizeGallons) { %><div><dt>Minimum Tank</dt><dd><%= specs.minimumTankSizeGallons %> gal</dd></div><% } %>
                            <% if (specs.adultSize) { %><div><dt>Adult Size</dt><dd><%= specs.adultSize %></dd></div><% } %>
                            <% if (specs.careLevel) { %><div><dt>Care Level</dt><dd><%= specs.careLevel %></dd></div><% } %>
                        <% } else if (product.category === 'Plants') { %>
                            <% if (specs.lightRequirement) { %><div><dt>Light</dt><dd><%= specs.lightRequirement %></dd></div><% } %>
                            <% if (specs.growthRate) { %><div><dt>Growth</dt><dd><%= specs.growthRate %></dd></div><% } %>
                            <% if (specs.maxHeight) { %><div><dt>Max Height</dt><dd><%= specs.maxHeight %></dd></div><% } %>
                            <% if (specs.careLevel) { %><div><dt>Care Level</dt><dd><%= specs.careLevel %></dd></div><% } %>
                        <% } else { %>
                            <% if (specs.productSize) { %><div><dt>Size / Capacity</dt><dd><%= specs.productSize %></dd></div><% } %>
                            <% if (specs.details) { %><div><dt>Specification</dt><dd><%= specs.details %></dd></div><% } %>
                        <% } %>
                    </dl>

                    <% if ((totalStock || 0) > 0) { %>
                        <form method="POST" action="/cart/add/<%= product._id %>" class="product-detail-cart-form">
                            <% if (hasVariants) { %><div class="mb-3 w-100"><label for="variantId" class="form-label">Choose variation</label><select class="form-select" name="variantId" id="variantId" required>
                                <% product.variants.forEach(v=>{ %><option value="<%= v._id %>" <%= v.stockQuantity===0?'disabled':'' %>><%= v.label %> — $<%= (v.salePrice || v.price).toFixed(2) %> — <%= v.stockQuantity ? v.stockQuantity + ' available' : 'Sold out' %> — <%= v.sku %></option><% }); %>
                                </select></div><% } %><div class="product-detail-quantity">
                                <label for="quantity" class="form-label">Quantity</label>
                                <input
                                    type="number"
                                    id="quantity"
                                    name="quantity"
                                    class="form-control"
                                    min="1"
                                    max="<%= hasVariants ? Math.max(...product.variants.map(v=>v.stockQuantity)) : product.stockQuantity %>"
                                    value="1"
                                    inputmode="numeric"
                                    required>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">Add to Cart</button>
                        </form>
                    <% } else { %>
                        <button type="button" class="btn btn-outline-secondary btn-lg w-100" disabled>Sold Out</button>
                    <% } %>

                    <a href="/inventory?category=<%= encodeURIComponent(product.category) %>" class="product-detail-back-link">← Back to <%= product.category %></a>
                </div>
            </div>
        </div>
    </div>
</div>
