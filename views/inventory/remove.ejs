<div class="container py-5 admin-remove-page">
  <nav class="site-breadcrumb mb-4" aria-label="Breadcrumb"><a href="/" class="breadcrumb-pill">Home</a><span class="breadcrumb-separator">›</span><a href="/inventory/list" class="breadcrumb-pill">Manage products</a><span class="breadcrumb-separator">›</span><span class="breadcrumb-pill active">Remove product</span></nav>
  <div class="admin-remove-shell">
    <p class="section-kicker">Inventory management</p>
    <h1>Remove product?</h1>
    <p class="text-muted">Review the item below before permanently deleting its product listing.</p>
    <div class="admin-remove-preview">
      <img src="<%= product.imageUrl %>" alt="<%= product.title %>" onerror="this.style.display='none'">
      <div>
        <p class="product-category mb-1"><%= product.category %><% if (product.animalType) { %> · <%= product.animalType %><% } %></p>
        <h2><%= product.title %></h2>
        <p class="mb-1"><strong>SKU:</strong> <%= product.sku || 'Not assigned' %></p>
        <p class="mb-0"><strong>Price:</strong> $<%= Number(product.price).toFixed(2) %></p>
      </div>
    </div>
    <div class="admin-remove-warning" role="alert"><strong>Permanent deletion.</strong> This removes the product listing and its uploaded image. Existing orders are retained for order history.</div>
    <form method="POST" action="/inventory/remove/<%= product._id %>" class="d-flex flex-wrap justify-content-end gap-2">
      <a class="btn btn-outline-secondary" href="/inventory/list">Keep product</a>
      <button class="btn btn-danger" type="submit">Yes, delete product</button>
    </form>
  </div>
</div>
