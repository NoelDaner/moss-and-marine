<div class="container admin-inventory-page py-4 py-lg-5">
    <div class="admin-page-heading">
        <div>
            <p class="section-kicker mb-2">Data Clerk</p>
            <h1>Product Inventory</h1>
            <p>Welcome, <%= user.firstName %>. Manage stock, pricing, listings, and product status from one place.</p>
        </div>
        <a href="/inventory/add" class="btn btn-primary admin-add-product">+ Add New Product</a>
    </div>

    <form class="admin-filter-panel" method="GET" action="/inventory/list">
        <div class="admin-filter-field">
            <label for="category">Category</label>
            <select class="form-select" id="category" name="category">
                <option value="">All Categories</option>
                <% categories.forEach(item => { %>
                    <option value="<%= item %>" <%= filters.category === item ? 'selected' : '' %>><%= item %></option>
                <% }); %>
            </select>
        </div>
        <div class="admin-filter-field">
            <label for="group">Animal type / family</label>
            <select class="form-select" id="group" name="group">
                <option value="">All animal types and families</option>
                <% let activeParent = ''; groups.forEach(entry => { %>
                    <% if (activeParent !== entry.parent) { activeParent = entry.parent; %><option disabled><%= activeParent %></option><% } %>
                    <option value="<%= entry.value %>" <%= filters.group === entry.value ? 'selected' : '' %>><%= entry.value.startsWith('family:') ? '↳ ' : '' %><%= entry.label %></option>
                <% }); %>
            </select>
        </div>
        <div class="admin-filter-field">
            <label for="status">Status / stock</label>
            <select class="form-select" id="status" name="status">
                <option value="">All products</option>
                <option value="juvenile" <%= filters.status === 'juvenile' ? 'selected' : '' %>>Has juvenile variant</option>
                <option value="featured" <%= filters.status === 'featured' ? 'selected' : '' %>>Featured</option>
                <option value="live" <%= filters.status === 'live' ? 'selected' : '' %>>Live animals</option>
                <option value="in-stock" <%= filters.status === 'in-stock' ? 'selected' : '' %>>In stock</option>
                <option value="low" <%= filters.status === 'low' ? 'selected' : '' %>>Low stock (1–3)</option>
                <option value="sold-out" <%= filters.status === 'sold-out' ? 'selected' : '' %>>Sold out</option>
            </select>
        </div>
        <div class="admin-filter-search">
            <label for="q">Search</label>
            <input class="form-control" id="q" type="search" name="q" value="<%= filters.search %>" placeholder="Name, SKU, type or family">
        </div>
        <input type="hidden" name="sort" value="<%= filters.sort %>">
        <button class="btn btn-primary" type="submit">Apply</button>
        <a class="btn btn-light admin-clear-filter" href="/inventory/list">Clear</a>
    </form>

    <div class="admin-inventory-toolbar">
        <span><strong><%= products.length %></strong> product<%= products.length === 1 ? '' : 's' %> · grouped by category</span>
        <form method="GET" action="/inventory/list">
            <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
            <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
            <% if (filters.group) { %><input type="hidden" name="group" value="<%= filters.group %>"><% } %>
            <% if (filters.search) { %><input type="hidden" name="q" value="<%= filters.search %>"><% } %>
            <label for="adminSort">Sort by</label>
            <select id="adminSort" class="form-select form-select-sm" name="sort" onchange="this.form.submit()">
                <option value="category" <%= filters.sort === 'category' ? 'selected' : '' %>>Category (A–Z)</option>
                <option value="title" <%= filters.sort === 'title' ? 'selected' : '' %>>Title (A–Z)</option>
                <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest</option>
                <option value="stock-low" <%= filters.sort === 'stock-low' ? 'selected' : '' %>>Lowest Stock</option>
            </select>
        </form>
    </div>

    <% if (products && products.length > 0) { %>
        <div class="admin-category-groups">
            <% for (const [category, categoryProducts] of Object.entries(productsByCategory)) { %>
                <section class="admin-category-group">
                    <div class="admin-category-heading">
                        <h2><%= category %></h2>
                        <span><%= categoryProducts.length %> product<%= categoryProducts.length === 1 ? '' : 's' %></span>
                    </div>
                    <div class="table-responsive">
                        <table class="table admin-product-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Image</th>
                                    <th>Title</th>
                                    <th>SKU</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% categoryProducts.forEach(product => { %>
                                    <tr>
                                        <td>
                                            <div class="admin-product-thumb-wrap">
                                                <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="admin-product-thumb">
                                            </div>
                                        </td>
                                        <td><a class="admin-product-title" href="/inventory/product/<%= product._id %>"><%= product.title %></a></td>
                                        <td><code class="admin-sku"><%= product.sku || 'Pending' %></code></td>
                                        <td>
                                            <% if (product.variants && product.variants.length) { const adult = product.variants.find(v => v.label.toLowerCase() === "adult") || product.variants[0]; %><span class="fw-semibold">$<%= (adult.salePrice || adult.price).toFixed(2) %></span><small class="d-block text-muted">Adult / base</small>
                                            <% } else if (product.salePrice) { %>
                                                <span class="text-decoration-line-through text-muted me-1">$<%= product.price.toFixed(2) %></span>
                                                <span class="sale-price">$<%= product.salePrice.toFixed(2) %></span>
                                            <% } else { %>
                                                $<%= product.price.toFixed(2) %>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% const visibleStock = product.variants && product.variants.length ? product.variants.reduce((sum, v) => sum + v.stockQuantity, 0) : (product.stockQuantity || 0); %>
                                            <% if (visibleStock > 0) { %>
                                                <span class="fw-semibold"><%= visibleStock %></span>
                                            <% } else { %>
                                                <span class="status-pill status-sold-out">Sold Out</span>
                                            <% } %>
                                        </td>
                                        <td class="admin-status-cell">
                                            <% if (product.featured) { %><span class="status-pill status-featured">Featured</span><% } %>
                                            <% if (product.category === 'Aquatic Life' || product.category === 'Live Fish') { %><span class="status-pill status-live"><%= product.animalType || 'Aquatic Life' %></span><% } %>
                                        </td>
                                        <td class="admin-actions">
                                            <a href="/inventory/edit/<%= product._id %>" class="btn btn-sm admin-action-btn">Edit</a>
                                            <a href="/inventory/remove/<%= product._id %>" class="btn btn-sm admin-delete-btn">Delete</a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </section>
            <% } %>
        </div>
    <% } else { %>
        <div class="site-empty-panel">
            <h2>No products found</h2>
            <p>Try clearing the filters or add a new product.</p>
        </div>
    <% } %>
</div>
