<% const variantProduct = product.variants && product.variants.length > 0; const totalStock = variantProduct ? product.variants.reduce((n,v)=>n+v.stockQuantity,0) : product.stockQuantity; %>
<div class="card product-card product-card-compact h-100 shadow-sm border-0 position-relative <%= (totalStock || 0) <= 0 ? 'product-card-sold-out' : '' %>">
    <% if ((totalStock || 0) <= 0) { %>
        <span class="product-status-ribbon product-status-sold-out">Sold Out</span>
    <% } else if (product.salePrice && !variantProduct) { %>
        <span class="product-status-ribbon product-status-sale">Sale</span>
    <% } else if (product.featured) { %>
        <span class="product-status-ribbon product-status-featured">Featured</span>
    <% } %>

    <a href="/inventory/product/<%= product._id %>" class="product-image-link <%= (product.animalType === 'Shrimp') ? 'product-image-shrimp' : '' %>" aria-label="View <%= product.title %>">
        <img src="<%= product.imageUrl %>" class="card-img-top" alt="<%= product.title %>" loading="lazy" decoding="async" onerror="this.hidden=true;this.nextElementSibling.hidden=false;">
        <span class="product-image-unavailable" hidden aria-label="Product image unavailable"><span>Image coming soon</span></span>
    </a>

    <div class="card-body d-flex flex-column">
        <p class="product-category mb-1"><%= product.category %><% if (product.animalType && product.category === 'Aquatic Life') { %> · <%= product.animalType %><% } %></p>
        <h5 class="card-title product-card-title mb-2">
            <a class="product-title-link" href="/inventory/product/<%= product._id %>"><%= product.title %></a>
        </h5>

        <div class="mt-auto">
            <div class="product-card-price mb-2">
                <% if (product.salePrice && !variantProduct) { %>
                    <span class="text-decoration-line-through text-muted me-1">$<%= (variantProduct ? Math.min(...product.variants.map(v => v.salePrice || v.price)) : product.price).toFixed(2) %></span>
                    <span class="fw-bold sale-price">$<%= product.salePrice.toFixed(2) %></span>
                <% } else { %>
                    <span class="fw-bold text-primary"><%= variantProduct ? 'From ' : '' %>$<%= (variantProduct ? Math.min(...product.variants.map(v => v.salePrice || v.price)) : product.price).toFixed(2) %></span>
                <% } %>
            </div>

            <% if ((totalStock || 0) <= 0) { %>
                <span class="small text-muted fw-semibold">Currently unavailable</span>
            <% } else { %>
                <div class="small text-muted mb-2 product-stock-line">
                    <%= totalStock %> in stock
                    <% if (totalStock <= 3) { %>
                        <span class="low-stock-text"> · Only <%= totalStock %> left</span>
                    <% } %>
                </div>
                <% if (variantProduct) { %><a class="btn btn-primary btn-sm w-100" href="/inventory/product/<%= product._id %>">Choose variation</a><% } else { %><form method="POST" action="/cart/add/<%= product._id %>" class="product-card-action">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Add to Cart</button>
                </form><% } %>
            <% } %>
        </div>
    </div>
</div>
